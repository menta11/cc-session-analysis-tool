# Dependencies
node_modules/

# Build output
out/
dist/
release/
releases/

# Linux 打包的本地预取缓存（包体与 marker，不入库）
build/linux/.cache/

# Tests & caches
.vitest-cache/
*.tsbuildinfo

# Logs
*.log
logs/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Environment / local config
.env
.env.local

# Claude Code 的临时 worktree 与本地设置（整仓副本，不入库）
.claude/

# 使用指南/ 使用文档不入库
使用指南/

# 本地工具产物与反馈样本不入库
.playwright-mcp/
feedback/

/docs/ui/
/docs/bugs/

# docs/调研/ 参考仓库：忽略压缩包与解压临时克隆，保留 .md 调研报告
docs/调研/*.zip
docs/调研/*-temp/

# real-sample 烟雾测试硬编码本机会话绝对路径，不进版本库。
# 从 test/real-sample.smoke.template.ts 复制为 .test.ts 并填入你本机路径后再跑。
test/real-sample*.smoke.test.ts

# Tauri v2 壳：Rust 构建产物 + CLI 生成的 schema 不入库
# 注：渲染层产物在 out/tauri-renderer，已被上面的 out/ 覆盖
src-tauri/target/
src-tauri/gen/
